{
  "name": "rezjs",
  "version": "1.0.0",
  "description": "The automated immune system for third-party webhooks and APIs. AI schema resilience, QuickJS WebAssembly sandboxing, and GitOps review.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "e2e": "tsx test-e2e.ts"
  },
  "keywords": [
    "rez",
    "rezjs",
    "resilience",
    "schema-drift",
    "self-healing",
    "webhooks",
    "dataops",
    "gitops",
    "zod",
    "ai-sdk",
    "quickjs",
    "webassembly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.0",
    "@ai-sdk/google": "^1.1.0",
    "@ai-sdk/openai": "^1.1.0",
    "@octokit/rest": "^21.1.0",
    "ai": "^4.1.0",
    "quickjs-emscripten": "^0.31.0",
    "simple-git": "^4.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
